@inherits Custom.Hybrid.RazorTyped
@using AppCode
@using AppCode.Extensions.Radmin
@using AppCode.Extensions.Radmin.Data
@using ToSic.Eav.Data
@using ToSic.Razor.Blade
@using ToSic.Sxc.Data

@{
  // 1. Get the viewId and entityId from the Model and URL parameters
  var viewId = MyModel.String("viewId");
  var detailSpecs = MyModel.Get<RadminDetails>("detailSpecs");
  var entityId = MyPage.Parameters.Get<Guid>(RadminConstants.UrlParamEntityGuid);
}

@if (!Text.Has(viewId) || entityId == Guid.Empty)
{
  <div class="alert alert-warning">
    Missing parameter <code>@RadminConstants.UrlParamEntityGuid</code>.
  </div>
  return;
}

@* Find the entity by ID, if not found, show error *@
@{var entity = App.Data.GetOne<Custom.Data.CustomItem>(entityId); }

@if (entity == null)
{
  <div class="alert alert-warning">
    Entity not found in provided datasource.
  </div>
  return;
}

@* Verify that the entity has the same content type as specified in detailSpecs *@
@if (entity.Type.Name != detailSpecs.DataContentType)
{
  <div class="alert alert-warning">
    Error: Entity content type does not match the detail view configuration.
  </div>
  entity = null;
  return;
}

@{
  // Get the content type definition to list all attributes
  var contentType = App.Data.GetContentType(detailSpecs.DataContentType);
}
<div @Kit.Toolbar.Empty().Edit(entity)>
  <h2>
    Details of:
    @entity.Title
    (@entity.Id)
  </h2>

  <table class="table table-bordered mt-4">
    <tbody>
      @foreach (var attr in contentType.Attributes)
      {
        var key = attr.Name;

        // Get the value
        // It needs "required: false" for special edge cases (data loaded from json may not have certain data)
        var value = entity.Get(key, required: false);

        // Determine if current attr is a group title (starts with "Group" and has no value)
        // Group titles should be rendered bold
        var isGroupTitle = attr.IsEmpty();
        var groupTitleClass = isGroupTitle ? "fw-bold" : "fw-normal";
        
        <tr>
          <th class="w-25 @groupTitleClass">
            @key
          </th>
          <td>
            @if (attr.IsEntity()) {
              var children = entity.Children(key);
              if (children != null && children.Any()) {
                <ul>
                  @foreach (var child in children)
                  {
                    <li>@child.Title (@child.Type.Name, @child.Id)</li>
                  }
                </ul>
              } else {
                <em>No related items</em>
              }
            }
            else if (attr.IsBoolean())
            {
              @(value == null ? "❓" : value as bool? == true ? "✅" : "❌")
            }
            else
            {
              @value
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
  
  <a href="@Link.To(parameters: MyPage.Parameters.Flush())" class="btn btn-primary mt-3">
    Back to Table View
  </a>
</div>
