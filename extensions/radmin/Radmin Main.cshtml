@inherits Custom.Hybrid.RazorTyped
@using AppCode.Extensions.Radmin
@using AppCode.Extensions.Radmin.Data

@{
  // 1. Start by using the data configured for this view
  // 1.1. Load the table config based on the current context (moduleId, viewId, etc.)
  var tableSpecs = As<RadminTable>(MyItem);

  // 2. Check if we should switch views
  // 2.1. Get the viewId from the URL parameters to determine if we should switch views to another table or the details
  var viewId = MyPage.Parameters.String(RadminConstants.UrlParamViewId, fallback: null);

  // 2.2. Check if the viewId in the URL is different from the current tableSpecs.ViewId.
  // If they are the same, it means we are already on the correct view and we should not switch,
  // to avoid breaking demo-item checks and other logic that relies on MyItem.
  var viewIdChanged = !string.IsNullOrWhiteSpace(viewId) && viewId != tableSpecs.ViewId.ToString();

  // 2.3. If viewID has not changed, show the table view as normal (default case).
  // If viewId has changed, we will switch to the correct view in the next steps.
  if (!viewIdChanged)
  {
    @Html.Partial("./Radmin Table.cshtml", new { tableSpecs })
    return;
  }

  // 2.4. Check if this is another table configuration
  tableSpecs = App.Data
    .GetAll<RadminTable>()
    .FirstOrDefault(t => t.ViewId == viewId);

  if (tableSpecs != null) {
    @Html.Partial("./Radmin Table.cshtml", new { tableSpecs })
    return;
  }

  // 3. Check if it's referencing a details view
  var detailSpecs = App.Data.GetAll<RadminDetails>()
    .FirstOrDefault(d => d.ViewId == viewId);

  if (detailSpecs != null)
  {
    @Html.Partial("Radmin Details.cshtml", new { viewId, detailSpecs });
    return;
  }
}

@* 4. Nothing found, show an error *@
<div class="alert alert-warning">
  View <code>@viewId</code> not found.
</div>
